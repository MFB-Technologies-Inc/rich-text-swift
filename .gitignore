.DS_Store
/.build
/Packages
xcuserdata/
DerivedData/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc

# Internal planning docs — not part of the OSS repo
/Documentation

# Local agent config — gitignored for now; specific skills will be un-ignored later
/CLAUDE.md
/.claude

# Only ever produced by the opt-in docs build (SWIFTRICHTEXT_DOCS=1). Committing it
# would pin swift-docc-plugin for everyone and force xcodebuild to resolve it,
# which breaks the iOS test loop in network-restricted environments.
Package.resolved

# Generated by `tuist generate` in Demo/
/Demo/*.xcodeproj
/Demo/*.xcworkspace
/Demo/Derived

# Benchmark baselines written by Scripts/benchmark (machine-specific, not shared)
/.benchmarkBaselines
